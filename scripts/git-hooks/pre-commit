#!/usr/bin/env bash
# Bumps the version in project.yml when a commit changes the app and the version was not bumped
# by hand: build number +1, patch version +1 (0.3.1 → 0.3.2). A hand-made bump (e.g. a minor one
# for a new feature) is kept; only the part left unchanged is bumped.
# Enabled once per clone with: git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Only commits that change what goes into the app.
git diff --cached --quiet -- MeetRec Resources project.yml && exit 0

staged=$(git diff --cached -U0 -- project.yml)
build_changed=$(grep -c '^+ *CURRENT_PROJECT_VERSION:' <<<"$staged" || true)
version_changed=$(grep -c '^+ *MARKETING_VERSION:' <<<"$staged" || true)
[ "$build_changed" -gt 0 ] && [ "$version_changed" -gt 0 ] && exit 0

# Bump the staged project.yml; refuse if it also has unstaged edits (they would get committed).
if ! git diff --quiet -- project.yml; then
  echo "pre-commit: project.yml has unstaged changes; stage them or bump the version by hand" >&2
  exit 1
fi

build=$(sed -nE 's/^ *CURRENT_PROJECT_VERSION: *"?([0-9]+)"?.*/\1/p' project.yml)
version=$(sed -nE 's/^ *MARKETING_VERSION: *"?([0-9.]+)"?.*/\1/p' project.yml)
if [ "$build_changed" -eq 0 ]; then
  build=$((build + 1))
  sed -i '' -E "s/^( *CURRENT_PROJECT_VERSION: *).*/\1\"$build\"/" project.yml
fi
if [ "$version_changed" -eq 0 ]; then
  IFS=. read -r major minor patch <<<"$version"
  version="$major.$minor.$((${patch:-0} + 1))"
  sed -i '' -E "s/^( *MARKETING_VERSION: *).*/\1\"$version\"/" project.yml
fi
git add project.yml
echo "pre-commit: version $version ($build)"
